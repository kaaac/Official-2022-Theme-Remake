{
    "BlockRoot": {
        "Name": "mainStack",
        "BlockType": "stack",
        "Margin": "{MarginRoot}",       
        "Orientation": "Vertical",
        "Items": [
            {
                "BlockType" : "component",
                "Component" : "header_block",
                "ComponentOptions" : {
                    "Vars" : {
                        "headerlefttext" : "{Season.LeagueInfo.LeagueShortName} · {Season.Name} · Qualification Positions"
                    }
                }
            },
            {
                "BlockType" : "component",
                "Component" : "separator"
            },
            {
                "Name": "mainTable",
                "BlockType": "table",
                "Margin": "{MarginTable}",
                "TableOptions": {
                    "ItemsSource": "{Standings.Drivers}",
                    "HeaderTemplate": {
                        "BlockType": "text",
                        "MarginBottom": 8
                    },
                    "Columns": [
                        {
                            "Header": "",
                            "Template": {
                                "BlockType": "component",
                                "Component": "position_cell",
                                "ComponentOptions": {
                                    "Vars": {
                                        "position": "{Item.Position}"
                                    }
                                }
                            }
                        },
                        {
                            "Header": "",
                            "MarginRight" : 24,
                            "Template": {
                                "BlockType": "component",
                                "Component": "driver_and_team_dock"
                            }
                        },
                        {
                            "MarginLeft" : 6,
                            "MultiColumnHeadersSource": "{Standings.Events}",
                            "MultiColumnItemsSource": "{Item.Events}",
                            // tylko rozegrane rundy - inaczej tabela zostaje szeroka z pustymi kolumnami
                            // (RenderIf w Template ukrywa tresc, ale NIE usuwa kolumny)
                            // alternatywa gdyby liczba byla przesunieta: {Standings.LastEvent.ChampionshipPosition}
                            "MultiColumnLimit": "{Season.SeasonCurrentNumberEventExcludingNonChampionship}",
                            "MultiColumnHeaderTemplate": {
                                "BlockType": "stack",
                                "Orientation": "Vertical",
                                "RenderIf" : "{Item.WinnerString, Converter=EmptyObjectToFalse}",
                                "Spacing": 4,
                                "HorizontalAlignment": "Center",
                                "Items": [
                                    {
                                        "BlockType": "image",
                                        "Source": "{Item.Track.Nation.LogotypePath}",
                                        "HorizontalAlignment": "Center",
                                        "Height": 32
                                    },
                                    {
                                        "BlockType": "text",
                                        "MarginBottom": 8,
                                        "HorizontalAlignment": "Center",
                                        "Source": "{Item.Track.Nation.Code}",
                                        "Style" : "tableHeader"                                       
                                    }
                                ]
                            },
                            "Width": 55,
                            "Template": {
                                "Padding": "12, 0",
                                "BlockType": "text",
                                "RenderIf" : "{Item.Event.WinnerString, Converter=EmptyObjectToFalse}",
                                "Source": "{Item.QualMajorPositionString}",
                                "HorizontalAlignment": "Left",
                                "Style" : "positionCell",
                                "TextOptions": {
                                    "HorizontalAlignment": "Center"
                                },
                                "Triggers": [
                                    {
                                        "Condition": "{Item.IsRaceMajorClassified, Converter=BoolReverse}",
                                        "Setters": [
                                            {
                                                "Property": "Foreground",
                                                "Value": "{SeasonProgressPositionNotClassifiedForeground}"
                                            }
                                        ]
                                    },
                                    {
                                        "Condition": "{Item.RaceMajorPosition, Converter=NumberLess, Parameter=11}",
                                        "Setters": [
                                            {
                                                "Property": "Foreground",
                                                "Value": "{SeasonProgressPositionTop10Foreground}"
                                            }
                                        ]
                                    },
                                    {
                                        "Condition": "{Item.QualMajorPosition, Converter=NumberEquals, Parameter=1}",
                                        "Setters": [
                                            {
                                                "Property": "Foreground",
                                                "Value": "{SeasonProgressPositionTop1Foregound}"
                                            }
                                        ]
                                    }
                                ]
                            }
                        }                        
                    ]
                }
            },
            {
                "BlockType" : "component",
                "Component" : "bg_footer"
            }
        ]
    }
}