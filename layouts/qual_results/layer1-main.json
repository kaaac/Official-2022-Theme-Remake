{
    "BlockRoot": {
        "Name": "mainStack",
        "BlockType": "stack",
        "Margin": "{MarginRoot}",    
        "Orientation": "Vertical",
        "Items": [
            {
                "BlockType" : "component",
                "Component" : "header_block_session"
            },
            {
                "BlockType" : "component",
                "Component" : "separator"
            },
            {
                "Name": "mainTable",
                "BlockType": "table",
                "Margin" : "{MarginTable}",
                "TableOptions": {
                    "ItemsSource": "{Session.Drivers}",
                    "RowSpacing": 0,
                    "ColSpacing": 0,
                    "HeaderTemplate": {
                        "BlockType": "text",
                        "MarginBottom": 0,
                        "Style" : "tableHeader",
                        "HorizontalAlignment" : "Center",
                        "Width" : "*"
                    },
                    "Columns": [
                        {
                            "Header": "",
                            "Template": {
                                "BlockType" : "component",                                
                                "Component" : "position_cell",
                                "ComponentOptions" :{
                                    "Vars" :{
                                        "position" : "{Item.PositionString}"
                                    }
                                }
                            }
                        },
                        {
                            "Header": "[DRIVER]",
                            "Template":
                            {
                                "BlockType" : "component",
                                "Component" : "driver_cell"                                
                            }
                        },
                        {
                            "Header": "[TEAM]",
                            "Template":
                            {
                                "BlockType" : "component",
                                "Component" : "team_cell",
                                "ComponentOptions" :{
                                    "Vars" :{
                                        "MarginRight": "{ColumnMarginRight}",
                                        "RenderIf" : "{RenderTeamBadgesOnSessionResults}"
                                    }
                                }
                            }
                        },
                        {
                            "Header": "[LAP TIME]",
                            "Template": {
                                "BlockType": "text",
                                "Padding": "6, 0",
                                "Source": "{Item.FastestLapTime}",
                                "MarginRight": "{ColumnMarginRight}",
                                "HorizontalAlignment": "Left",
                                "Style" : "driverCell",
                                "RenderIf" : "{Session.IsLiveData}",
                                "TextOptions": {
                                    "HorizontalAlignment": "Center"
                                },
                                "Triggers" :[
                                    {
                                        "Condition" : "{RenderQualiStints}",
                                        "Property" : "MarginRight",
                                        "Value" : 0
                                    },
                                    {
                                        "Condition" : "{Item.FastestLapTime, Converter=EmptyObjectToTrue}",
                                        "Property" : "Source",
                                        "Value" : "--:--.---"
                                    }
                                ] 
                            }
                        },
                        {
                            "Header": "[STINTS]",
                            "Template": {
                                "BlockType": "itemstack",
                                "Spacing": 4,
                                "HorizontalAlignment": "Left",
                                "MarginRight": "{ColumnMarginRight}",
                                "RenderIf" : "{RenderQualiStints}",
                                "ItemStackOptions": {
                                    "ItemSource": "{Item.Stints}",
                                    "Template": {
                                        "BlockType": "stack",
                                        "VerticalAlignment": "Top",
                                        "PaddingTop" : 7,
                                        "HorizontalAlignment":"Center",
                                        "Spacing": 0,
                                        "Height": 17,
                                        "Items": [
                                            {
                                                "BlockType": "image",
                                                "Height": 17,
                                                "VerticalAlignment": "Center",
                                                "Source": "tyres/tyres_{Item.Tyres}.png",
                                                "HorizontalAlignment":"Center"
                                            }                                           
                                        ]
                                    }
                                }
                            }
                        },
                        {
                            "Header": "[TIME/GAP]",
                            "Template": {
                                "BlockType": "text",
                                "Padding": "6, 0",
                                "Source": "{Item.Time}",
                                "HorizontalAlignment": "Left",
                                "MarginRight": "{ColumnMarginRight}",
                                "Style" : "driverCell",
                                "TextOptions": {
                                    "HorizontalAlignment": "Center"
                                },
                                "RenderIf": true,
                                "Triggers" :[
                                    {
                                        "Condition" : "{Item.Time, Converter=EmptyObjectToTrue}",
                                        "Property" : "Source",
                                        "Value" : "--:--.---"
                                    }
                                ]
                            }
                        },
                        {
                            "Header" : "[PLACE PEN.]",
                            "Template" : {
                                "BlockType" : "text",
                                "Source" : "+{Item.PenaltyPosIngame}",
                                "RenderIf" : "{Item.PenaltyPosIngame, Converter=NumberNotEquals, Parameter=0}",
                                "Width" :85,
                                "Style":"PenPos",
                                "MarginRight": "{ColumnMarginRight}",
                                "HorizontalAlignment":"Center",
                                "TextOptions" : {
                                    "HorizontalAlignment" : "Center"
                                }
                            }
                        },
                        {
                            "Header": "[LAPS]",
                            "Template": {
                                "BlockType": "text",
                                "Padding": "6, 0",
                                "Source": "{Item.LapsCount}",
                                "HorizontalAlignment": "Left",
                                "Width":75,
                                "Style" : "driverCell",
                                "RenderIf" : "{Session.IsLiveData}",
                                "TextOptions": {
                                    "HorizontalAlignment": "Center"
                                }
                            }
                        }
                    ]
                }
            },
            {
                "BlockType" : "component",
                "Component" : "bg_footer"
            }          
        ]
    }
}
