{
    "ComponentName": "header_block_2lines",
    "BlockType": "dock",
    "Orientation": "Horizontal",
    "Foreground" : "{ForeGroundWhite}",
    "MarginLeft" : 0,
    "PaddingTop" : 20,
    "PaddingBottom" : 8,
    "UseBackgroundCrop": true,
    "Width" : "*",
