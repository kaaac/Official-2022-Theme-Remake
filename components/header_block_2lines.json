                    "Orientation": "Vertical",
                    "VerticalAlignment": "Center",
                    "MarginTop" : "{MarginTopHeaderText}",
                    "Items": [
                        {
                            "BlockType": "text",
                            "Source": "<headerline1>",
                            "Style": "headerLeftTextOptions",
                            "HorizontalAlignment": "Center",
                            "TextOptions": {
                                "HorizontalAlignment": "Center"
                            }
                        },
                        {
                            "BlockType": "text",
                            "Source": "<headerline2>",
                            "Style": "headerLeftTextOptions",
                            "FontSize": "{HeaderLeftFontSizeSmall}",
                            "HorizontalAlignment": "Center",
                            "TextOptions": {
                                "HorizontalAlignment": "Center",
                                "FontSize": "{HeaderLeftFontSizeSmall}"
                            }
                        }
                    ]
                }
            ]
        }
    ]
