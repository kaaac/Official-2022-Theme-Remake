        {
            "Name": "headerLeftPart",
            "BlockType": "stack",
            "Orientation": "Horizontal",
            "Margin" : "{HeaderLeftMargin}",
            "HorizontalAlignment": "Left",
            "VerticalAlignment" : "Center",
            "Items": [
                {
                    "BlockType" : "component",
                    "Component" : "f1_logo_header",
                    "VerticalAlignment" : "Center"
                },
                {
                    "BlockType" : "component",
                    "Component" : "league_logo_header",
                    "VerticalAlignment" : "Center"
                },
                {
                    "Name": "headerTextLines",
